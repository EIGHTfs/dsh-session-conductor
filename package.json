{
  "name": "dsh-session-conductor",
  "version": "1.4.29",
  "description": "DSH session management: panel with archive/trash/delete/undo, automatic rename and interrupted-session resume, six-way session-log repair (structure, zstd frames, seq gaps, EIO blocks, dual-format conflict, tool arguments), value analysis, full-text search, plan/closing template injection, and AI team tooling (per-member model and permission switching, member execution traces, cross-session messaging, memory recall, context usage).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "skills",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "session-manager",
    "archive",
    "restore",
    "delete",
    "auto-rename",
    "auto-resume",
    "interruption",
    "workspace",
    "group",
    "undo",
    "repair",
    "template-injection"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node test/run-all.mjs",
    "test:unit": "node test/run-all.mjs --unit",
    "test:api": "node test/run-all.mjs --api"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.1-alpha.2",
    "@deepseek-ai/dsh-session-title": ">=0.2.1-alpha.2",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.1-alpha.2",
    "@deepseek-ai/schemastery": ">=3.18.5-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-title": {
      "optional": true
    },
    "@deepseek-ai/dsh-storage-domain": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "skills": [
      "./skills/dsh-session-conductor.md",
      "./skills/dsh-session-conductor-functions.md",
      "./skills/task-completion-report.md",
      "./skills/dsh-session-official-doc.md"
    ]
  },
  "author": "EIGHTfs",
  "repository": {
    "type": "git",
    "url": "https://github.com/EIGHTfs/dsh-session-conductor.git"
  }
}
